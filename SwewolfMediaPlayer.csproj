<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\SwewolfMediaPlayer.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>SweWolf Media Player</AssemblyTitle>
    <Product>SweWolf Media Player</Product>
    <Company>SweWolf Software</Company>
    <Copyright>SweWolf Software</Copyright>
    <Authors>SweWolf</Authors>
    <Description>A media player with frame stepping and frame saving</Description>
    <!-- 64-bit Windows on Intel/AMD only. Only the x64 LibVLC files are copied: fewer files for the virus scanner
         to check at the first start, and a smaller download. (ARM PCs run the x64 program in emulation.) -->
    <PlatformTarget>x64</PlatformTarget>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SwewolfMediaPlayer.ico" LogicalName="SwewolfMediaPlayer.ico" />
    <!-- Help > SweWolf Media Player Help (F1). Rebuild it from help.md with docs\build-help.cmd -->
    <Content Include="docs\help.html" Link="Help\help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Also embedded in the EXE: HelpFiles.cs saves it to %AppData% and opens it when the Help folder is missing -->
    <EmbeddedResource Include="docs\help.html">
      <LogicalName>Help/help.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- License and notices: next to the EXE in every download (the GPL text and the source pointer for the VLC DVD plugins are required) -->
  <ItemGroup>
    <Content Include="LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Plugins of VLC 3.0.24 (GPL) that the LibVLC package leaves out (DVD reader, AC-3 packetizer): they go into LibVLC's own plugin folders (access, packetizer) (see Resources\VlcDvd\README.txt). -->
  <ItemGroup>
    <None Include="Resources\VlcDvd\**\*.dll" Link="libvlc\win-x64\plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>